classDiagram
  class Owner {
    +String name
    +int available_minutes
    +add_pet(pet)
    +get_all_tasks()
  }
  class Pet {
    +String name
    +String species
    +add_task(task)
    +get_tasks()
  }
  class Task {
    +String title
    +int duration_minutes
    +String priority
    +bool completed
    +mark_complete()
  }
  class Scheduler {
    +Owner owner
    +generate_plan()
    +explain_plan()
  }
  Owner "1" --> "*" Pet : has
  Pet "1" --> "*" Task : has
  Scheduler --> Owner : plans for
  Scheduler ..> Task : sorts and picks