classDiagram
  class Owner {
    +String name
    +int available_minutes
    +list~Pet~ pets
    +add_pet(pet) None
    +get_all_tasks() list~Task~
  }
  class Pet {
    +String name
    +String species
    +list~Task~ tasks
    +add_task(task) None
    +get_tasks() list~Task~
  }
  class Task {
    +String title
    +int duration_minutes
    +String priority
    +bool completed
    +String pet_name
    +mark_complete() None
  }
  class Scheduler {
    +Owner owner
    +list~Task~ plan
    +list~Task~ skipped
    +generate_plan() list~Task~
    +explain_plan() String
  }
  Owner "1" --> "*" Pet : has
  Pet "1" --> "*" Task : has
  Task --> Pet : belongs to (pet_name)
  Scheduler --> Owner : plans for
  Scheduler --> Task : plan / skipped
